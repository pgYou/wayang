{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/rpc/*": ["./packages/protocol/src/rpc/*"],
      "@/types/*": ["./packages/protocol/src/types/*"],
      "@/__tests__/*": ["./packages/core/src/__tests__/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["e2e/**/*"],
  "exclude": ["node_modules", "dist"]
}
