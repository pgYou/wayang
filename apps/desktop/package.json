{
  "name": "@wayang-ai/desktop",
  "version": "1.0.0-alpha.1",
  "private": true,
  "description": "Wayang desktop — Electron shell; UtilityProcess hosts the wayang server, renderer is React + shadcn-style UI",
  "author": "pgYou",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && cp ../../apps/cli/dist/mcp-bridge-entry.js out/main/",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dist": "npm run build && node scripts/stage-runtime-deps.mjs && electron-builder --mac",
    "dist:dir": "npm run build && node scripts/stage-runtime-deps.mjs && electron-builder --mac --dir"
  },
  "build": {
    "appId": "ai.wayang.desktop",
    "productName": "Wayang",
    "extraMetadata": {
      "productName": "Wayang"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      {
        "from": ".runtime-node-modules",
        "to": "node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "out/main/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "icon": "../../assets/logo/wayang-mark-icon-512.png"
    },
    "dmg": {
      "backgroundColor": "#f7f9fc"
    }
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@ant-design/x-markdown": "^2.10.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-virtual": "^3.14.28",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@wayang-ai/core": "workspace:*",
    "@wayang-ai/protocol": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "41.7.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "happy-dom": "^21.0.4",
    "html-react-parser": "^5.2.17",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5"
  }
}
