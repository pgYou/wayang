{
  "name": "@wayang-ai/desktop",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Wayang desktop — Electron shell; UtilityProcess hosts the wayang server, renderer is React + shadcn-style UI",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && cp ../../apps/cli/dist/mcp-bridge-entry.js out/main/",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@wayang-ai/core": "1.0.0-alpha.0",
    "@wayang-ai/protocol": "1.0.0-alpha.0",
    "electron": "^41.7.1",
    "electron-vite": "^6.0.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.5"
  }
}
