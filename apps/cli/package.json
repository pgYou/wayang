{
  "name": "@wayang-ai/cli",
  "version": "1.0.0-alpha.1",
  "description": "Wayang CLI — the `wayang` / `waya` terminal entry: multi-agent orchestration TUI and process host",
  "type": "module",
  "license": "MIT",
  "author": "pgYou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pgYou/wayang.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/pgYou/wayang#readme",
  "bugs": {
    "url": "https://github.com/pgYou/wayang/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "multi-agent",
    "orchestration",
    "cli",
    "llm",
    "claude"
  ],
  "bin": {
    "wayang": "dist/cli.js",
    "waya": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.87",
    "@anthropic-ai/claude-agent-sdk": "^0.2.98",
    "ai": "^6.0.218",
    "fast-glob": "^3.3.3",
    "ink": "^4.4.1",
    "lodash-es": "^4.18.1",
    "meow": "^14.1.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prompts": "^2.4.2",
    "react": "^18.3.1",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@wayang-ai/core": "1.0.0-alpha.0",
    "@wayang-ai/protocol": "1.0.0-alpha.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  }
}
