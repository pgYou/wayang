# Wayang Dev Config
WAYANG_LLM_API_KEY=sk-ant-xxx
# WAYANG_ENDPOINT=https://api.anthropic.com
# WAYANG_MODEL=claude-sonnet-4-20250514
# Model context window in tokens (input budget; compaction starts at 90%). Default 256000
# WAYANG_CONTEXT_WINDOW_TOKENS=128000
# WAYANG_TAVILY_API_KEY=tvly-xxx
# Set to 1 to log the full (sanitized) prompt messages on each controller LLM
# call at DEBUG level. Default off: only call metadata is logged (model /
# message count / token estimate). Requires --verbose (debug level) to have
# any effect.
# WAYANG_LOG_PROMPTS=1