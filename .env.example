# Wayang Dev Config
WAYANG_LLM_API_KEY=sk-ant-xxx
# Without a config file, WAYANG_LLM_API_KEY + WAYANG_ENDPOINT + WAYANG_MODEL build
# an implicit model named "default" (equivalent to providers.default +
# models.default, referenced by controller.model / worker.model). With a config
# file, the file's model bindings win; WAYANG_LLM_API_KEY only fills a missing
# apiKey, and the env model is a last resort when the file binds no model.
# WAYANG_ENDPOINT=https://api.anthropic.com
# Equivalent to models.default.name
# WAYANG_MODEL=claude-sonnet-4-20250514
# Equivalent to models.default.contextWindowTokens — the model context window in
# tokens (input budget; compaction starts at 60%). Default 256000
# WAYANG_CONTEXT_WINDOW_TOKENS=128000
# WAYANG_TAVILY_API_KEY=tvly-xxx
# Set to 1 to log the full (sanitized) prompt messages on each controller LLM
# call at DEBUG level. Default off: only call metadata is logged (model /
# message count / token estimate). Requires --verbose (debug level) to have
# any effect.
# WAYANG_LOG_PROMPTS=1# Fallback cap (chars) for ONE tool result stored in a conversation
# transcript. Tool-layer truncation (8000/2000 chars) applies first; this is
# the write-layer bound that catches tools without their own cap. Default
# 20000.
# WAYANG_TOOL_OUTPUT_MAX_CHARS=20000
