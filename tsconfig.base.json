{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ES2023", "ESNext.Array", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "noEmit": true,
    "jsx": "react-jsx"
  }
}
