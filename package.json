{
  "name": "wayang-ai",
  "version": "1.0.0-alpha.1",
  "private": true,
  "description": "Wayang — multi-agent orchestration platform（monorepo workspace 根；对外发布单元为 @wayang-ai/cli）",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "cli": "npm run build && node --env-file=.env.local apps/cli/dist/cli.js --wayang-root . -w . -c ./config.local.json --verbose",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "npm run build && vitest run --config e2e.config.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "lint": "npm run check:boundaries && turbo run lint && eslint e2e/"
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "@types/react": "^18.3.28",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tsup": "^8.5.1",
    "turbo": "^2.11.13",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  }
}
