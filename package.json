{
  "name": "wayang-ai",
  "version": "1.0.0-alpha.0",
  "description": "Multi-agent orchestration platform",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "author": "pgYou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pgYou/wayang.git"
  },
  "homepage": "https://github.com/pgYou/wayang#readme",
  "bugs": {
    "url": "https://github.com/pgYou/wayang/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "multi-agent",
    "orchestration",
    "cli",
    "llm",
    "claude"
  ],
  "bin": {
    "wayang": "apps/cli/dist/cli.js",
    "waya": "apps/cli/dist/cli.js"
  },
  "files": [
    "apps/cli/dist",
    "!apps/cli/dist/**/*.map"
  ],
  "scripts": {
    "build": "turbo run build",
    "cli": "npm run build && node --env-file=.env.local apps/cli/dist/cli.js --wayang-root . -w . -c ./config.local.json --verbose",
    "prepublishOnly": "npm run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "npm run build && vitest run --config e2e.config.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "lint": "npm run check:boundaries && turbo run lint && eslint e2e/"
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.87",
    "@anthropic-ai/claude-agent-sdk": "^0.2.98",
    "@types/react": "^18.3.28",
    "ai": "^6.0.218",
    "fast-glob": "^3.3.3",
    "ink": "^4.4.1",
    "lodash-es": "^4.18.1",
    "meow": "^14.1.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prompts": "^2.4.2",
    "react": "^18.3.1",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tsup": "^8.5.1",
    "turbo": "^2.11.13",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  }
}