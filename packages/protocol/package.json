{
  "name": "@wayang-ai/protocol",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Wayang protocol layer — shared types and RPC framing",
  "type": "module",
  "dependencies": {
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/lodash-es": "^4.17.12",
    "eslint": "^9.0.0",
    "fast-glob": "^3.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "types": "./dist/types/index.d.ts"
}
