{
  "name": "@wayang/cli",
  "version": "1.0.0-alpha.0",
  "description": "Wayang CLI — the terminal UI and the `wayang` entry point",
  "type": "module",
  "license": "MIT",
  "bin": {
    "wayang": "dist/cli.js",
    "waya": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "dependencies": {
    "@wayang/core": "1.0.0-alpha.0",
    "@wayang/protocol": "1.0.0-alpha.0"
  },
  "exports": {
    ".": "./src/cli.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  }
}
