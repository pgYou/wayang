{
  "name": "@wayang-ai/core",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Wayang core — services, infrastructure and the server",
  "type": "module",
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.87",
    "@anthropic-ai/claude-agent-sdk": "^0.2.98",
    "@wayang-ai/protocol": "workspace:*",
    "ai": "^6.0.218",
    "fast-glob": "^3.3.3",
    "lodash-es": "^4.18.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/lodash-es": "^4.17.12",
    "esbuild": "^0.27.0",
    "eslint": "^9.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "types": "./dist/index.d.ts"
}
